MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1244604815}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a7d505186a963a340a6bb9216dd429c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PatientInfoPanel
  windowRoot: {fileID: 1244604815}
  tabButtons:
  - {fileID: 719705674}
  - {fileID: 1605998373}
  tabDataList:
  - tabName: Normal Mode
    patientSprite: {fileID: 4217565692946668088, guid: 1b50530155fcbc747b2c9477532e9854, type: 3}
    patientName: "\u0E19\u0E32\u0E22\u0E2A\u0E21\u0E0A\u0E32\u0E22 \u0E2A\u0E38\u0E02\u0E2A\u0E21\u0E1A\u0E39\u0E23\u0E13\u0E4C "
    patientDescription: "[ \u0E02\u0E49\u0E2D\u0E21\u0E39\u0E25\u0E17\u0E31\u0E48\u0E27\u0E44\u0E1B
      ]\r\n\u2022 \u0E2D\u0E32\u0E0A\u0E35\u0E1E : \u0E1E\u0E19\u0E31\u0E01\u0E07\u0E32\u0E19\u0E2D\u0E2D\u0E1F\u0E1F\u0E34\u0E28
      (\u0E19\u0E31\u0E48\u0E07\u0E17\u0E33\u0E07\u0E32\u0E19\u0E15\u0E25\u0E2D\u0E14\u0E27\u0E31\u0E19)\r\n\u2022
      \u0E04\u0E48\u0E32\u0E44\u0E02\u0E21\u0E31\u0E19 LDL \u0E43\u0E19\u0E40\u0E25\u0E37\u0E2D\u0E14
      : 175 mg/dL (\u0E40\u0E01\u0E34\u0E19\u0E40\u0E01\u0E13\u0E11\u0E4C\u0E21\u0E32\u0E15\u0E23\u0E10\u0E32\u0E19)\r\n\u2022
      \u0E1E\u0E24\u0E15\u0E34\u0E01\u0E23\u0E23\u0E21 : \u0E0A\u0E2D\u0E1A\u0E17\u0E32\u0E19\u0E02\u0E2D\u0E07\u0E17\u0E2D\u0E14
      \u0E0A\u0E32\u0E44\u0E02\u0E48\u0E21\u0E38\u0E01 \u0E41\u0E25\u0E30\u0E44\u0E21\u0E48\u0E04\u0E48\u0E2D\u0E22\u0E44\u0E14\u0E49\u0E2D\u0E2D\u0E01\u0E01\u0E33\u0E25\u0E31\u0E07\u0E01\u0E32\u0E22\r\n\r\n[
      \u0E1A\u0E31\u0E19\u0E17\u0E36\u0E01\u0E2D\u0E32\u0E01\u0E32\u0E23\u0E40\u0E1A\u0E37\u0E49\u0E2D\u0E07\u0E15\u0E49\u0E19
      ]\r\n\u0E1C\u0E39\u0E49\u0E1B\u0E48\u0E27\u0E22\u0E15\u0E23\u0E27\u0E08\u0E1E\u0E1A\u0E23\u0E30\u0E14\u0E31\u0E1A\u0E44\u0E02\u0E21\u0E31\u0E19\u0E40\u0E25\u0E27
      (LDL) \u0E2A\u0E30\u0E2A\u0E21\u0E43\u0E19\u0E01\u0E23\u0E30\u0E41\u0E2A\u0E40\u0E25\u0E37\u0E2D\u0E14\u0E2A\u0E39\u0E07\u0E08\u0E32\u0E01\u0E01\u0E32\u0E23\u0E15\u0E23\u0E27\u0E08\u0E2A\u0E38\u0E02\u0E20\u0E32\u0E1E\u0E1B\u0E23\u0E30\u0E08\u0E33\u0E1B\u0E35
      \u0E40\u0E23\u0E34\u0E48\u0E21\u0E21\u0E35\u0E2D\u0E32\u0E01\u0E32\u0E23\u0E40\u0E2B\u0E19\u0E37\u0E48\u0E2D\u0E22\u0E07\u0E48\u0E32\u0E22
      \u0E2D\u0E48\u0E2D\u0E19\u0E40\u0E1E\u0E25\u0E35\u0E22\u0E43\u0E19\u0E15\u0E2D\u0E19\u0E1A\u0E48\u0E32\u0E22\r\n\r\n[
      \u0E27\u0E31\u0E15\u0E16\u0E38\u0E1B\u0E23\u0E30\u0E2A\u0E07\u0E04\u0E4C\u0E01\u0E32\u0E23\u0E23\u0E31\u0E01\u0E29\u0E32
      ]\r\n\u0E04\u0E27\u0E1A\u0E04\u0E38\u0E21\u0E22\u0E32\u0E19\u0E02\u0E19\u0E32\u0E14\u0E40\u0E25\u0E47\u0E01\u0E40\u0E02\u0E49\u0E32\u0E2A\u0E39\u0E48\u0E2B\u0E25\u0E2D\u0E14\u0E40\u0E25\u0E37\u0E2D\u0E14
      \u0E01\u0E33\u0E08\u0E31\u0E14\u0E2D\u0E19\u0E38\u0E20\u0E32\u0E04 LDL \u0E2A\u0E48\u0E27\u0E19\u0E40\u0E01\u0E34\u0E19
      \u0E41\u0E25\u0E30\u0E1B\u0E49\u0E2D\u0E07\u0E01\u0E31\u0E19\u0E44\u0E21\u0E48\u0E43\u0E2B\u0E49\u0E44\u0E02\u0E21\u0E31\u0E19\u0E2B\u0E25\u0E38\u0E14\u0E23\u0E2D\u0E14\u0E44\u0E1B\u0E40\u0E01\u0E32\u0E30\u0E1C\u0E19\u0E31\u0E07\u0E2B\u0E25\u0E2D\u0E14\u0E40\u0E25\u0E37\u0E2D\u0E14\u0E2A\u0E48\u0E27\u0E19\u0E1B\u0E25\u0E32\u0E22"
    sceneToLoad: CutsceneScene
  - tabName: Mission
    patientSprite: {fileID: -6381605330626397364, guid: 02693f8d1d823ce42973e08d63dff366, type: 3}
    patientName: "\u0E20\u0E32\u0E23\u0E01\u0E34\u0E08\u0E1B\u0E23\u0E30\u0E08\u0E33\u0E14\u0E48\u0E32\u0E19
      1"
    patientDescription: "[ \u0E20\u0E32\u0E23\u0E01\u0E34\u0E08\u0E2B\u0E25\u0E31\u0E01
      : MAIN MISSION ]\r\n- \u0E04\u0E27\u0E1A\u0E04\u0E38\u0E21\u0E22\u0E32\u0E19\u0E1D\u0E48\u0E32\u0E2D\u0E38\u0E1B\u0E2A\u0E23\u0E23\u0E04\u0E44\u0E1B\u0E43\u0E2B\u0E49\u0E16\u0E36\u0E07\u0E40\u0E2A\u0E49\u0E19\u0E0A\u0E31\u0E22\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E1B\u0E25\u0E2D\u0E14\u0E20\u0E31\u0E22\r\n\r\n[
      \u0E40\u0E07\u0E37\u0E48\u0E2D\u0E19\u0E44\u0E02\u0E01\u0E32\u0E23\u0E23\u0E31\u0E1A\u0E14\u0E32\u0E27
      : 3 STARS ]\r\n[1] \u0E14\u0E32\u0E27\u0E14\u0E27\u0E07\u0E17\u0E35\u0E48 1
      : \u0E40\u0E02\u0E49\u0E32\u0E40\u0E2A\u0E49\u0E19\u0E0A\u0E31\u0E22\u0E2A\u0E33\u0E40\u0E23\u0E47\u0E08\r\n[2]
      \u0E14\u0E32\u0E27\u0E14\u0E27\u0E07\u0E17\u0E35\u0E48 2 : \u0E17\u0E33\u0E41\u0E15\u0E49\u0E21\u0E2A\u0E30\u0E2A\u0E21\u0E04\u0E23\u0E1A\u0E01\u0E33\u0E2B\u0E19\u0E14
      (Score: 100)\r\n[3] \u0E14\u0E32\u0E27\u0E14\u0E27\u0E07\u0E17\u0E35\u0E48
      3 : \u0E1B\u0E49\u0E2D\u0E07\u0E01\u0E31\u0E19\u0E28\u0E31\u0E15\u0E23\u0E39\u0E2B\u0E25\u0E38\u0E14\u0E23\u0E2D\u0E14\u0E44\u0E21\u0E48\u0E40\u0E01\u0E34\u0E19
      5 \u0E15\u0E31\u0E27\r\n\r\n[ \u0E04\u0E33\u0E40\u0E15\u0E37\u0E2D\u0E19\u0E1E\u0E34\u0E40\u0E28\u0E29
      : WARNING ]\r\n! \u0E23\u0E30\u0E27\u0E31\u0E07\u0E2A\u0E31\u0E0D\u0E0D\u0E32\u0E13\u0E40\u0E15\u0E37\u0E2D\u0E19\u0E02\u0E35\u0E1B\u0E19\u0E32\u0E27\u0E38\u0E18
      (Missile Alert) \u0E1E\u0E38\u0E48\u0E07\u0E0A\u0E19"
    sceneToLoad: CutsceneScene

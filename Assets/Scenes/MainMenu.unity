  m_Script: {fileID: 11500000, guid: e9f2acaaf9b598c43bd46eb56ac62978, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PatientSystemManager
  avatarDisplayImage: {fileID: 652003240}
  patientNameText: {fileID: 1580858468}
  profileBoxText: {fileID: 640886545}
  contentBoxText: {fileID: 769868766}
  topicButtons:
  - {fileID: 502897133}
  - {fileID: 383937371}
  - {fileID: 1026842294}
  patients:
  - patientName: "\u0E40\u0E01\u0E48\u0E07 \u0E02\u0E22\u0E35\u0E49\u0E19\u0E21"
    patientAvatar: {fileID: 4592761091510274918, guid: aa23f468b3abd784b841fa0ff74031b0, type: 3}
    targetSceneName: FippyLDL
    introductionSpeech: "\u0E2A\u0E27\u0E31\u0E2A\u0E14\u0E35\u0E04\u0E23\u0E31\u0E1A\u0E04\u0E38\u0E13\u0E2B\u0E21\u0E2D
      \u0E1C\u0E21\u0E40\u0E01\u0E48\u0E07 \u0E02\u0E22\u0E35\u0E49\u0E19\u0E21\u0E04\u0E23\u0E31\u0E1A
      \u0E0A\u0E48\u0E27\u0E07\u0E19\u0E35\u0E49\u0E23\u0E39\u0E49\u0E2A\u0E36\u0E01\u0E40\u0E2B\u0E19\u0E37\u0E48\u0E2D\u0E22\u0E07\u0E48\u0E32\u0E22
      \u0E41\u0E19\u0E48\u0E19\u0E2B\u0E19\u0E49\u0E32\u0E2D\u0E01\u0E1A\u0E48\u0E2D\u0E22\u0E46
      \u0E42\u0E14\u0E22\u0E40\u0E09\u0E1E\u0E32\u0E30\u0E40\u0E27\u0E25\u0E32\u0E02\u0E31\u0E1A\u0E23\u0E16\u0E2A\u0E48\u0E07\u0E02\u0E2D\u0E07\u0E17\u0E32\u0E07\u0E44\u0E01\u0E25
      \u0E40\u0E25\u0E22\u0E41\u0E27\u0E30\u0E21\u0E32\u0E15\u0E23\u0E27\u0E08\u0E14\u0E39\u0E04\u0E23\u0E31\u0E1A"
    generalProfile: "\u0E0A\u0E37\u0E48\u0E2D: \u0E19\u0E32\u0E22\u0E2A\u0E21\u0E0A\u0E32\u0E22
      \u0E0A\u0E32\u0E0D\u0E27\u0E34\u0E17\u0E22\u0E4C (\u0E2D\u0E32\u0E22\u0E38
      54 \u0E1B\u0E35)\n\u0E2D\u0E32\u0E0A\u0E35\u0E1E: \u0E1E\u0E19\u0E31\u0E01\u0E07\u0E32\u0E19\u0E02\u0E31\u0E1A\u0E23\u0E16\u0E1A\u0E23\u0E23\u0E17\u0E38\u0E01\u0E02\u0E19\u0E2A\u0E48\u0E07\n\u0E04\u0E27\u0E32\u0E21\u0E14\u0E31\u0E19\u0E42\u0E25\u0E2B\u0E34\u0E15:
      145/92 mmHg (\u0E23\u0E30\u0E14\u0E31\u0E1A 1 Hypertension)"
    topics:
    - buttonTitle: "\u0E01\u0E32\u0E23\u0E01\u0E34\u0E19"
      detailContent: "[\u0E1E\u0E24\u0E15\u0E34\u0E01\u0E23\u0E23\u0E21\u0E01\u0E32\u0E23\u0E23\u0E31\u0E1A\u0E1B\u0E23\u0E30\u0E17\u0E32\u0E19\u0E2D\u0E32\u0E2B\u0E32\u0E23]:\n\u0E0A\u0E2D\u0E1A\u0E17\u0E32\u0E19\u0E02\u0E2D\u0E07\u0E17\u0E2D\u0E14
        \u0E41\u0E01\u0E07\u0E01\u0E30\u0E17\u0E34 \u0E02\u0E49\u0E32\u0E27\u0E02\u0E32\u0E2B\u0E21\u0E39\u0E40\u0E1B\u0E47\u0E19\u0E1B\u0E23\u0E30\u0E08\u0E33\n\u0E14\u0E37\u0E48\u0E21\u0E01\u0E32\u0E41\u0E1F\u0E01\u0E23\u0E30\u0E1B\u0E4B\u0E2D\u0E07\u0E23\u0E2A\u0E2B\u0E27\u0E32\u0E19\u0E27\u0E31\u0E19\u0E25\u0E30
        2-3 \u0E01\u0E23\u0E30\u0E1B\u0E4B\u0E2D\u0E07\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E41\u0E01\u0E49\u0E07\u0E48\u0E27\u0E07\n\u0E1C\u0E25\u0E15\u0E23\u0E27\u0E08\u0E04\u0E2D\u0E40\u0E25\u0E2A\u0E40\u0E15\u0E2D\u0E23\u0E2D\u0E25\u0E23\u0E27\u0E21\u0E2A\u0E39\u0E07\u0E16\u0E36\u0E07
        260 mg/dL (\u0E44\u0E02\u0E21\u0E31\u0E19\u0E40\u0E25\u0E27 LDL \u0E2A\u0E39\u0E07)\""
    - buttonTitle: "\u0E2A\u0E39\u0E1A\u0E1A\u0E38\u0E2B\u0E23\u0E35\u0E48"
      detailContent: "[\u0E1E\u0E24\u0E15\u0E34\u0E01\u0E23\u0E23\u0E21\u0E01\u0E32\u0E23\u0E2A\u0E39\u0E1A\u0E1A\u0E38\u0E2B\u0E23\u0E35\u0E48]:\n\u0E2A\u0E39\u0E1A\u0E1A\u0E38\u0E2B\u0E23\u0E35\u0E48\u0E40\u0E1B\u0E47\u0E19\u0E1B\u0E23\u0E30\u0E08\u0E33\u0E40\u0E09\u0E25\u0E35\u0E48\u0E22\u0E27\u0E31\u0E19\u0E25\u0E30
        1 \u0E0B\u0E2D\u0E07 (20 \u0E21\u0E27\u0E19)\n\u0E2A\u0E39\u0E1A\u0E15\u0E48\u0E2D\u0E40\u0E19\u0E37\u0E48\u0E2D\u0E07\u0E21\u0E32\u0E19\u0E32\u0E19\u0E01\u0E27\u0E48\u0E32
        25 \u0E1B\u0E35\n\u0E2A\u0E48\u0E07\u0E1C\u0E25\u0E43\u0E2B\u0E49\u0E2B\u0E25\u0E2D\u0E14\u0E40\u0E25\u0E37\u0E2D\u0E14\u0E41\u0E02\u0E47\u0E07\u0E15\u0E31\u0E27\u0E41\u0E25\u0E30\u0E21\u0E35\u0E04\u0E27\u0E32\u0E21\u0E40\u0E2A\u0E35\u0E48\u0E22\u0E07\u0E15\u0E48\u0E2D\u0E20\u0E32\u0E27\u0E30\u0E01\u0E25\u0E49\u0E32\u0E21\u0E40\u0E19\u0E37\u0E49\u0E2D\u0E2B\u0E31\u0E27\u0E43\u0E08\u0E02\u0E32\u0E14\u0E40\u0E25\u0E37\u0E2D\u0E14\u0E2A\u0E39\u0E07"
  - patientName: "\u0E41\u0E1A\u0E07\u0E15\u0E4C \u0E40\u0E25\u0E48\u0E19\u0E02\u0E35\u0E49"
    patientAvatar: {fileID: 4592761091510274918, guid: aa23f468b3abd784b841fa0ff74031b0, type: 3}
    targetSceneName: FippyLDL
    introductionSpeech: "\u0E2A\u0E27\u0E31\u0E2A\u0E14\u0E35\u0E04\u0E48\u0E30\u0E04\u0E38\u0E13\u0E2B\u0E21\u0E2D
      \u0E14\u0E34\u0E09\u0E31\u0E19\u0E41\u0E1A\u0E07\u0E15\u0E4C \u0E40\u0E25\u0E48\u0E19\u0E02\u0E35\u0E49
      \u0E0A\u0E48\u0E27\u0E07\u0E19\u0E35\u0E49\u0E15\u0E37\u0E48\u0E19\u0E19\u0E2D\u0E19\u0E21\u0E32\u0E41\u0E25\u0E49\u0E27\u0E21\u0E35\u0E2D\u0E32\u0E01\u0E32\u0E23\u0E21\u0E36\u0E19\u0E2B\u0E31\u0E27
      \u0E40\u0E27\u0E35\u0E22\u0E19\u0E28\u0E35\u0E23\u0E29\u0E30\u0E1A\u0E48\u0E2D\u0E22\u0E46
      \u0E40\u0E25\u0E22\u0E2D\u0E22\u0E32\u0E01\u0E21\u0E32\u0E15\u0E23\u0E27\u0E08\u0E2A\u0E38\u0E02\u0E20\u0E32\u0E1E\u0E14\u0E39\u0E04\u0E48\u0E30"
    generalProfile: "\u0E02\u0E49\u0E2D\u0E21\u0E39\u0E25\u0E1C\u0E39\u0E49\u0E1B\u0E48\u0E27\u0E22:\u0E0A\u0E37\u0E48\u0E2D:
      \u0E41\u0E1A\u0E07\u0E15\u0E4C \u0E40\u0E25\u0E48\u0E19\u0E02\u0E35\u0E49 (\u0E2D\u0E32\u0E22\u0E38
      48 \u0E1B\u0E35)\n\u0E2D\u0E32\u0E0A\u0E35\u0E1E: \u0E40\u0E08\u0E49\u0E32\u0E02\u0E2D\u0E07\u0E23\u0E49\u0E32\u0E19\u0E40\u0E1A\u0E40\u0E01\u0E2D\u0E23\u0E35\u0E48\n
      \u0E04\u0E27\u0E32\u0E21\u0E14\u0E31\u0E19\u0E42\u0E25\u0E2B\u0E34\u0E15: 130/85
      mmHg"
    topics:
    - buttonTitle: "\u0E01\u0E32\u0E23\u0E01\u0E34\u0E19"
      detailContent: "[\u0E1E\u0E24\u0E15\u0E34\u0E01\u0E23\u0E23\u0E21\u0E01\u0E32\u0E23\u0E23\u0E31\u0E1A\u0E1B\u0E23\u0E30\u0E17\u0E32\u0E19\u0E2D\u0E32\u0E2B\u0E32\u0E23]:\n\u0E0A\u0E2D\u0E1A\u0E17\u0E32\u0E19\u0E02\u0E2D\u0E07\u0E17\u0E2D\u0E14
        \u0E41\u0E01\u0E07\u0E01\u0E30\u0E17\u0E34 \u0E02\u0E49\u0E32\u0E27\u0E02\u0E32\u0E2B\u0E21\u0E39\u0E40\u0E1B\u0E47\u0E19\u0E1B\u0E23\u0E30\u0E08\u0E33\n\u0E14\u0E37\u0E48\u0E21\u0E01\u0E32\u0E41\u0E1F\u0E01\u0E23\u0E30\u0E1B\u0E4B\u0E2D\u0E07\u0E23\u0E2A\u0E2B\u0E27\u0E32\u0E19\u0E27\u0E31\u0E19\u0E25\u0E30
        2-3 \u0E01\u0E23\u0E30\u0E1B\u0E4B\u0E2D\u0E07\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E41\u0E01\u0E49\u0E07\u0E48\u0E27\u0E07\n\u0E1C\u0E25\u0E15\u0E23\u0E27\u0E08\u0E04\u0E2D\u0E40\u0E25\u0E2A\u0E40\u0E15\u0E2D\u0E23\u0E2D\u0E25\u0E23\u0E27\u0E21\u0E2A\u0E39\u0E07\u0E16\u0E36\u0E07
        260 mg/dL (\u0E44\u0E02\u0E21\u0E31\u0E19\u0E40\u0E25\u0E27 LDL \u0E2A\u0E39\u0E07)\""
